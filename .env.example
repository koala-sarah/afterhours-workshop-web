# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings -> API / API Keys) ---------------------------
# Public: safe in the browser. All access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_ or import in client code.
# Used by Server Actions to call the booking/enquiry submit functions, and to
# derive the hashed client id used for rate limiting.
SUPABASE_SECRET_KEY=

# --- Local tooling only -------------------------------------------------------
# Postgres connection string, used to run supabase/verify/security_checks.sql.
# Local Supabase (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# --- Site ---------------------------------------------------------------------
# Public URL of the deployed site (canonical URLs, sitemap, structured data),
# e.g. https://www.example.co.nz (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# --- Cloudflare Turnstile (bot protection on public forms) --------------------
# Site key is public by design; the secret key is server only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Telegram (new-request alerts to the operators' group) --------------------
# Server only. Leave empty to disable; requests are still saved.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Resend (optional email backup of the alert) ------------------------------
# Server only. Leave empty to disable. Comma-separated NOTIFY_EMAIL_TO allowed.
# NOTIFY_EMAIL_FROM defaults to Resend's test sender (onboarding@resend.dev), which only
# delivers to the Resend account's own address until a domain is verified.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# --- Scheduled alert sending ----------------------------------------------------
# Shared secret for POST /api/notifications/dispatch (retries, abandoned chats).
# Store the same value in Supabase Vault as notify_dispatch_secret (migration 1060).
# Generate: openssl rand -hex 32
NOTIFY_DISPATCH_SECRET=
